{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "gotflashes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "prepare": "husky",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint resources/js/**/*.js",
    "lint:css": "stylelint \"resources/css/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "blade-formatter": "^1.44.2",
    "concurrently": "^9.2.4",
    "css-tree": "^3.2.1",
    "eslint": "^10.4.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.7",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "laravel-vite-plugin": "^3.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0"
  }
}
